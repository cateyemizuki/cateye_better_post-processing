{
  "manifest_version": 2,
  "id": "github.cateye.better-post-processing",
  "version": "0.11.3",
  "name": "更好的消息后处理",
  "description": "出站消息增强：宿主关闭「回复后处理总开关」与「丰富回复」时，以与 MaiBot 完全一致的原逻辑接管错别字注入与分段，并按宿主分段结果每段一条消息发送（首段走宿主原生链路，其余由插件补发并模拟打字，更正段引用上一段）；宿主关闭「启用引用回复」与「丰富回复」时按权重抽取直接/引用/@/引用＋@回复方式（群聊与私聊权重、「同一消息只引用一次」各自独立，私聊恒不 @）；planner 回复未带表情包时按概率补发；群友连续发表情包时按情绪跟风；支持对 bot 纯文本做词替换或整条覆盖；维护表情包准确含义库并把含义注入 replyer 上下文。",
  "author": { "name": "cateye", "url": "https://github.com/cateyemizuki" },
  "license": "GPL-3.0-or-later",
  "urls": { "repository": "https://github.com/cateyemizuki/cateye_better_post-processing" },
  "host_application": { "min_version": "1.2.3", "max_version": "1.99.99" },
  "sdk": { "min_version": "2.8.0", "max_version": "2.99.99" },
  "dependencies": [
    { "type": "python_package", "name": "jieba", "version_spec": ">=0.42.1" },
    { "type": "python_package", "name": "pypinyin", "version_spec": ">=0.54.0" }
  ],
  "capabilities": [
    "api.call",
    "config.get",
    "message.get_by_id",
    "message.get_by_time_in_chat",
    "emoji.get_by_description",
    "emoji.get_random",
    "emoji.get_count",
    "database.query",
    "database.delete",
    "llm.generate",
    "send.emoji",
    "send.text"
  ],
  "i18n": { "default_locale": "zh-CN", "supported_locales": ["zh-CN", "en"] },
  "plugin_type": "extension",
  "changelog": "CHANGELOG.md"
}
