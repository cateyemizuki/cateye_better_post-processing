{
  "manifest_version": 2,
  "id": "github.cateye.better-post-processing",
  "version": "0.6.1",
  "name": "更好的消息后处理",
  "description": "出站消息增强：框架关闭引用回复时按权重抽取直接/引用/@/引用＋@回复方式；planner 回复未带表情包时按概率补发；群友连续发表情包时按情绪跟风；支持对 bot 纯文本做词替换或整条覆盖；维护表情包准确含义库并把含义注入 replyer 上下文。",
  "author": { "name": "cateye", "url": "https://github.com/cateyemizuki" },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/cateyemizuki/cateye_better_post-processing"
  },
  "host_application": { "min_version": "1.2.3", "max_version": "1.99.99" },
  "sdk": { "min_version": "2.8.0", "max_version": "2.99.99" },
  "dependencies": [],
  "capabilities": [
    "config.get",
    "message.get_by_id",
    "message.get_by_time_in_chat",
    "emoji.get_by_description",
    "emoji.get_random",
    "emoji.get_all",
    "database.query",
    "llm.generate",
    "send.emoji"
  ],
  "i18n": { "default_locale": "zh-CN", "supported_locales": ["zh-CN", "en"] },
  "plugin_type": "extension"
}
