{
  "manifest_version": 2,
  "id": "github.cateye.better-post-processing",
  "version": "2.4.6",
  "name": "更好的消息后处理",
  "description": "QQ 消息回复增强：支持分段与打字节奏、错字生成和纠正、引用与 @ 权重、文本过滤、表情包互动及含义库、自回复与重复回复拦截、跨聊私聊回忆。适用于 MaiBot 1.4.x。",
  "author": {
    "name": "cateye",
    "url": "https://github.com/cateyemizuki"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/cateyemizuki/cateye_better_post-processing"
  },
  "host_application": {
    "min_version": "1.4.0",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.20.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "jieba",
      "version_spec": ">=0.42.1"
    },
    {
      "type": "python_package",
      "name": "pypinyin",
      "version_spec": ">=0.54.0"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=11.3.0"
    }
  ],
  "capabilities": [
    "api.call",
    "config.get",
    "message.get_by_id",
    "message.get_by_time_in_chat",
    "emoji.get_by_description",
    "emoji.get_random",
    "emoji.get_count",
    "database.query",
    "llm.generate",
    "send.emoji",
    "send.text",
    "send.image",
    "send.forward",
    "render.html2png",
    "chat.get_all_streams",
    "chat.get_stream_by_user_id",
    "message.get_recent"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN",
      "en"
    ]
  },
  "plugin_type": "extension",
  "changelog": "CHANGELOG.md",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/logo.png",
      "fallback": "package",
      "background": "#F2F1ED"
    }
  }
}
